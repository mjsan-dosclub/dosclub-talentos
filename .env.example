# Copy to apps/web/.env.local for local Next.js execution. Never commit secrets.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Configure independently for preview and production on Vercel.
RESEND_API_KEY=
EMAIL_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# One-time initial owner setup. Remove BOOTSTRAP_ADMIN_PASSWORD from every
# environment immediately after `npm run bootstrap:admin` succeeds.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
